<mxfile host="app.diagrams.net">
  <diagram name="AI Chatbot Architecture">
    <mxGraphModel>
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- User Queries -->
        <mxCell id="user_queries" value="User Queries" style="shape=ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="100" y="100" width="150" height="50" as="geometry" />
        </mxCell>

        <!-- Knowledge Base -->
        <mxCell id="knowledge_base" value="Knowledge Base" style="shape=rectangle;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="300" y="100" width="150" height="50" as="geometry" />
        </mxCell>

        <!-- LLM -->
        <mxCell id="llm" value="LLM (Language Model)" style="shape=rectangle;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="500" y="100" width="150" height="50" as="geometry" />
        </mxCell>

        <!-- Response Generation -->
        <mxCell id="response_generation" value="Response Generation" style="shape=ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="700" y="100" width="150" height="50" as="geometry" />
        </mxCell>

        <!-- Edges -->
        <mxCell id="query_to_kb" edge="1" parent="1" source="user_queries" target="knowledge_base">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="kb_to_llm" edge="1" parent="1" source="knowledge_base" target="llm">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="llm_to_response" edge="1" parent="1" source="llm" target="response_generation">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>